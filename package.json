{
  "name": "vibe-signals",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "indexer": "tsx indexer.ts",
    "migrate": "tsx scripts/run-migrations.ts",
    "migrate:dry": "tsx scripts/run-migrations.ts --dry-run",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@privy-io/react-auth": "^3.48.0",
    "@privy-io/wagmi": "^4.0.18",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@stripe/stripe-js": "^10.0.0",
    "@tanstack/react-query": "^5.104.1",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "dotenv": "^18.0.5",
    "html-to-image": "^1.11.13",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.57.3",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  }
}
